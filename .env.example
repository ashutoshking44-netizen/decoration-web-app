# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only variables starting with VITE_ are exposed to the browser.

# ── Web app (required) ─────────────────────────────────────────────
# Supabase project URL and anon/publishable key. The anon key is public by
# design; data is protected by Row Level Security policies in the database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── Web app (optional) ─────────────────────────────────────────────
# Base URL of the optional legacy local API (server/index.mjs), used as a fallback.
VITE_API_URL=

# ── Local API server (optional, `bun run api`) ─────────────────────
API_PORT=4000

# ── Database scripts (optional: `bun run migrate`, `bun run seed`) ──
# Direct Postgres connection. Server-side only — never prefix with VITE_.
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# NOTE: The Supabase service_role key must NEVER be placed in this file with a
# VITE_ prefix or anywhere in frontend code. Edge functions read it from
# Supabase secrets (SUPABASE_SERVICE_ROLE_KEY), not from this file.
